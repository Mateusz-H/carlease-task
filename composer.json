{
    "name": "carleasepolska/recruitment-shortlist",
    "type": "project",
    "license": "proprietary",
    "require": {
        "doctrine/doctrine-bundle": "2.11.4",
        "doctrine/doctrine-migrations-bundle": "3.7.0",
        "doctrine/orm": "2.20.13",
        "ecotone/dbal": "1.316.1",
        "ecotone/symfony-bundle": "1.316.1",
        "php": "^8.4",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "^0.14"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.34",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false
        }
    },
    "minimum-stability": "stable"
}
